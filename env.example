# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=taller_mecanico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Pool & Debugging
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SQL_ECHO=false

# Security & Authentication
BCRYPT_ROUNDS=12
