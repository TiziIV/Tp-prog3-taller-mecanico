Cookie: {{loginAdminC19.response.headers.Set-Cookie}}

{
  "patente": "AA123BB",
  "marca": "Volkswagen",
  "modelo": "Gol Trend",
  "anio": 2020
}

# Respuesta esperada:
# HTTP/1.1 201 Created

