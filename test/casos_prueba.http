### ------------------------------------------------------------------------------
### CASO C-13: Cancelar orden
### Resultado esperado: Dueño cancela orden pendiente (200); ajena da 403; terminada 409
### ------------------------------------------------------------------------------

# @name loginLauraC13
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "cliente@example.com",
  "password": "Password123!"
}

###

# Laura cancela su orden 1 (PENDIENTE) -> 200
# @no-cookie-jar
POST {{baseUrl}}/ordenes/1/cancelar
Cookie: {{loginLauraC13.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 200 OK
# { "id": 1, "estado": "CANCELADA", ... }

###

# Laura intenta cancelar orden 2 (de Jorge) -> 403
# @no-cookie-jar
POST {{baseUrl}}/ordenes/2/cancelar
Cookie: {{loginLauraC13.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 403 Forbidden
# { "detail": "No tiene permiso para cancelar esta orden" }

###

# Preparar orden 2 en estado TERMINADA (reponer stock y terminar con ADMIN)
# @name loginAdminC13
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Password123!"
}

###

# @no-cookie-jar
POST {{baseUrl}}/repuestos/3/reponer
Content-Type: application/json
Cookie: {{loginAdminC13.response.headers.Set-Cookie}}

{
  "cantidad": 10,
  "motivo": "Reposición C-13"
}

###

# @no-cookie-jar
POST {{baseUrl}}/ordenes/2/terminar
Cookie: {{loginAdminC13.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 200 OK
# { "id": 2, "estado": "TERMINADA", ... }

###

# Intento de cancelar orden TERMINADA por cliente no dueño -> 403 antes que 409 (RN-12)
# @no-cookie-jar
POST {{baseUrl}}/ordenes/2/cancelar
Cookie: {{loginLauraC13.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 403 Forbidden
# { "detail": "No tiene permiso para cancelar esta orden" }

###

# Intento de cancelar orden TERMINADA por personal autorizado (ADMIN) -> 409 (RN-11)
# @no-cookie-jar
POST {{baseUrl}}/ordenes/2/cancelar
Cookie: {{loginAdminC13.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 409 Conflict
# { "detail": "No se puede cancelar una orden en estado TERMINADA" }


