### ------------------------------------------------------------------------------
### CASO C-18: Cambiar precio de un repuesto y después sólo su descripción
### ------------------------------------------------------------------------------

# @name loginAdminC18
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Password123!"
}

###

# 1. Cambiar precio -> Agrega línea al historial
# @no-cookie-jar
PATCH {{baseUrl}}/repuestos/1
Content-Type: application/json
Cookie: {{loginAdminC18.response.headers.Set-Cookie}}

{
  "precio": "9500.00"
}

###

# Consultar historial de precios
# @no-cookie-jar
GET {{baseUrl}}/repuestos/1/precios
Cookie: {{loginAdminC18.response.headers.Set-Cookie}}

# Respuesta esperada: 2 líneas en total

###

# 2. Cambiar sólo descripción -> No agrega línea al historial de precios
# @no-cookie-jar
PATCH {{baseUrl}}/repuestos/1
Content-Type: application/json
Cookie: {{loginAdminC18.response.headers.Set-Cookie}}

{
  "descripcion": "Filtro de aceite alto rendimiento"
}

###

# Consultar historial de precios de nuevo -> Sigue teniendo exactamente 2 líneas
# @no-cookie-jar
GET {{baseUrl}}/repuestos/1/precios
Cookie: {{loginAdminC18.response.headers.Set-Cookie}}

###

# 3. La recepción intenta hacer PATCH /repuestos/1 -> 403 Forbidden
# @name loginRecepcionC18
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "recepcion@example.com",
  "password": "Password123!"
}

###

# @no-cookie-jar
PATCH {{baseUrl}}/repuestos/1
Content-Type: application/json
Cookie: {{loginRecepcionC18.response.headers.Set-Cookie}}

{
  "precio": "10000.00"
}

# Respuesta esperada:
# HTTP/1.1 403 Forbidden
# { "detail": "Permiso denegado: se requiere uno de los roles ('ADMIN',)" }


