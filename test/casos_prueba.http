### ------------------------------------------------------------------------------
### CASO C-16: Búsqueda con sql injection; paginación con filtro; PATCH parcial y PATCH de stock
### ------------------------------------------------------------------------------

# @name loginAdminC16
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Password123!"
}

###

# Búsqueda con ' OR '1'='1 -> Lista vacía con total 0
# @no-cookie-jar
GET {{baseUrl}}/repuestos?q=%27%20OR%20%271%27=%271
Cookie: {{loginAdminC16.response.headers.Set-Cookie}}

# Respuesta esperada:
# { "items": [], "total": 0, "page": 1, "size": 20, "pages": 1 }

###

# Paginación con filtro q=freno&size=1
# @no-cookie-jar
GET {{baseUrl}}/repuestos?q=freno&size=1
Cookie: {{loginAdminC16.response.headers.Set-Cookie}}

# Respuesta esperada:
# { "total": 1, "page": 1, "size": 1, "pages": 1, "items": [...] }

###

# Pedir page=2 cuando solo hay 1 página -> 422
# @no-cookie-jar
GET {{baseUrl}}/repuestos?q=freno&size=1&page=2
Cookie: {{loginAdminC16.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 422 Unprocessable Entity
# { "detail": "La página 2 no existe: hay 1" }

###

# size=500 fuera de rango -> 422
# @no-cookie-jar
GET {{baseUrl}}/repuestos?size=500
Cookie: {{loginAdminC16.response.headers.Set-Cookie}}

# Respuesta esperada:
# HTTP/1.1 422 Unprocessable Entity

###

# Intentar modificar stock por PATCH -> 422 (extra="forbid")
# @no-cookie-jar
PATCH {{baseUrl}}/repuestos/1
Content-Type: application/json
Cookie: {{loginAdminC16.response.headers.Set-Cookie}}

{
  "stock": 100
}

# Respuesta esperada:
# HTTP/1.1 422 Unprocessable Entity
# { "detail": "Extra inputs are not permitted" }


